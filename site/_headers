/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'none'; img-src 'self' https://raw.githubusercontent.com; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

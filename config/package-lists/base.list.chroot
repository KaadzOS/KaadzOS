linux-image-amd64
firmware-linux
network-manager
wpasupplicant
wireless-regdb
polkitd

# Portals: file pickers, notifications and screen sharing. The GTK backend
# covers general desktop integration; the wlroots backend implements
# ScreenCast/Screenshot on Sway. /etc/xdg/xdg-desktop-portal/portals.conf
# selects the two backends per interface.
xdg-desktop-portal
xdg-desktop-portal-gtk
xdg-desktop-portal-wlr

# Bluetooth: BlueZ plus Blueman. Blueman's notification-daemon dependency is
# already provided by mako-notifier, so no second notification daemon lands in
# the image. The GSettings backend and gsettings CLI are explicit because apt
# recommends are off. The service is enabled by a live hook; Debian's unit has
# ConditionPathIsDirectory=/sys/class/bluetooth, so machines without an adapter
# skip it instead of failing.
bluez
blueman
dconf-gsettings-backend
libglib2.0-bin
sway
swaybg
swaylock
swayidle
slurp
libnotify-bin
waybar
foot
xwayland
fuzzel
mako-notifier
grim
xdg-utils
breeze-cursor-theme
adwaita-icon-theme
fonts-dejavu-core
fonts-jetbrains-mono
fonts-font-awesome
kbd
brightnessctl
# Control centre: zenity renders the menu, upower supplies battery state,
# power-profiles-daemon backs the Waybar profile module, and wlsunset is the
# night-light backend. wlsunset needs the wlr-gamma-control protocol; the
# helper hides the item when it cannot start, so a headless VM stays healthy.
upower
power-profiles-daemon
wlsunset
zenity
user-setup
live-config-systemd
sudo
dbus
libpam-systemd
libgl1-mesa-dri
pipewire-audio
alsa-ucm-conf
dbus-user-session
rtkit
pavucontrol
qt6ct
curl
ca-certificates
gnupg

# Installer (Calamares) and the tools its modules call. Calamares only
# recommends squashfs-tools, and the base image runs with recommends off, so
# every runtime dependency it needs must be listed explicitly.
calamares
squashfs-tools
rsync
python3
python3-toml
qt6-wayland
qml6-module-qtquick
qml6-module-qtquick-window
parted
e2fsprogs
dosfstools
mtools
cryptsetup
cryptsetup-initramfs
initramfs-tools
zstd
grub-common
grub2-common
grub-efi-amd64-bin
grub-pc-bin
efibootmgr
locales
console-setup
keyboard-configuration

# Installed-system login: greetd + tuigreet. The live image keeps greetd
# disabled; Calamares enables it in the target system.
greetd
tuigreet
wtype

# Phase 6: lean default applications. GNOME Web (Epiphany) is the browser:
# WebKitGTK renders natively on Wayland and it is the smallest full-featured
# browser in trixie (no bundled engine stack of its own). The rest follow the
# same lean-first rule: Thunar (files), Mousepad (text), imv (images),
# zathura+poppler (PDF). xdg-user-dirs gives the standard ~/Videos etc.
epiphany-browser
thunar
mousepad
imv
zathura
zathura-pdf-poppler
wf-recorder
xdg-user-dirs

# File manager integration. Thunar's native menu stays primary; the archive
# plugin adds compress/extract, and xarchiver is the lean archive manager that
# ships its own tap in /usr/lib/thunar-archive-plugin (the plugin package only
# carries the ark, engrampa and file-roller taps). wl-clipboard backs Copy Path.
# gvfs, gvfs-fuse, udisks2, thunar-volman and tumbler provide trash, removable
# media and thumbnails; lxpolkit is the session polkit authentication agent.
# gvfs-backends supplies the admin:// backend and stays in the admin pack so
# the base image does not carry the SMB/MTP/camera stack by default.
thunar-archive-plugin
xarchiver
wl-clipboard
gvfs
gvfs-fuse
udisks2
thunar-volman
tumbler
lxpolkit

# Phase 6: bootsplash. The script plugin ships in plymouth core; plymouth-themes
# is still installed for the two-step fallback machinery and the label plugins
# come from plymouth-label. The AMOLED theme lives in theme/generate.sh output.
plymouth
plymouth-themes
plymouth-label

# Phase 6: compressed swap in RAM + graceful memory tuning.
zram-tools

# Phase 6: Secure Boot support for the INSTALLED system. Debian's grub-install
# prefers the signed GRUB images and shim when these packages are present, so
# a Calamares install boots with Secure Boot enabled. The live ISO's own GRUB
# stays unsigned; the live image booted with Secure Boot disabled on purpose.
shim-signed
grub-efi-amd64-signed

# Core command-line baseline. apt-recommends is off, so every tool the
# desktop, installer and diagnostics rely on must be named explicitly.
# rsync, e2fsprogs and zstd are already listed in their feature sections above.
bash
dash
zsh
coreutils
util-linux
# fdisk is a split util-linux package in trixie; the command is not installed
# by util-linux itself, so the boot test and disk work need it explicitly.
fdisk
findutils
grep
gawk
tar
gzip
xz-utils
file
less
man-db
manpages
tree
pciutils
usbutils
procps
lsof
# p7zip-full is only a transitional package in trixie; 7zip provides /usr/bin/7z.
7zip
unzip
zip

/* KaadzOS Calamares stylesheet (generated from theme/palette). */

QWidget {
    background-color: #000000;
    color: #ffffff;
    selection-background-color: #ffffff;
    selection-color: #000000;
}

QMainWindow, QDialog {
    background-color: #000000;
}

/* The Calamares slideshow is a QQuickWidget; the QML root paints the real
   background, but this keeps the widget black before the scene has rendered. */
QQuickWidget {
    background-color: #000000;
}

#sidebarApp {
    background-color: #050505;
}

#logoApp {
    padding: 12px;
}

QPushButton {
    background-color: #161616;
    color: #ffffff;
    border: 1px solid #292929;
    border-radius: 6px;
    padding: 7px 18px;
    min-width: 84px;
}

QPushButton:hover {
    border-color: #ffffff;
    color: #ffffff;
}

QPushButton:default, QPushButton:focus {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #000000;
    font-weight: 600;
}

QPushButton:disabled {
    background-color: #0a0a0a;
    border-color: #161616;
    color: #8a8a8a;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #0a0a0a;
    color: #ffffff;
    border: 1px solid #292929;
    border-radius: 4px;
    padding: 5px 8px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #ffffff;
}

QComboBox QAbstractItemView {
    background-color: #0a0a0a;
    color: #ffffff;
    selection-background-color: #161616;
    selection-color: #ffffff;
}

QCheckBox, QRadioButton, QLabel {
    color: #ffffff;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QGroupBox {
    border: 1px solid #292929;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #9c9c9c;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QProgressBar {
    background-color: #0a0a0a;
    border: 1px solid #292929;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #ffffff;
    border-radius: 3px;
}

QListWidget, QTreeView, QTableView {
    background-color: #050505;
    color: #ffffff;
    border: 1px solid #292929;
    selection-background-color: #161616;
    selection-color: #ffffff;
}

QToolTip {
    background-color: #161616;
    color: #ffffff;
    border: 1px solid #ffffff;
    padding: 4px;
}

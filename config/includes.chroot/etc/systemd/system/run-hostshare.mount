[Unit]
Description=KaadzOS host shared folder (9p virtio, QEMU boot test only)
DefaultDependencies=no
ConditionPathExists=/sys/bus/virtio/drivers/9pnet_virtio
After=systemd-remount-fs.service
Before=sysinit.target

[Mount]
What=hostshare
Where=/run/hostshare
Type=9p
Options=trans=virtio,version=9p2000.L,rw,access=any

[Install]
WantedBy=sysinit.target

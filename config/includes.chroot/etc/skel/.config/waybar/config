{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["custom/install", "network", "bluetooth", "pulseaudio", "battery", "tray"],
    "sway/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] }
    },
    "sway/mode": { "format": " {} " },
    "custom/install": {
        "format": "{}",
        "exec": "test -e /etc/kaadzos/installed || printf ' Install '",
        "hide-empty-text": true,
        "interval": 5,
        "on-click": "kaadzos-install",
        "tooltip": true,
        "tooltip-format": "Install KaadzOS to disk"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": { "mode": "month" }
    },
    "network": {
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\uf1e6 {ifname}",
        "format-disconnected": "\uf127 offline",
        "tooltip-format": "{ipaddr}/{cidr}"
    },
    "bluetooth": {
        "format": "{icon}",
        "format-connected": "{icon} {device_alias}",
        "format-connected-battery": "{icon} {device_alias} {device_battery_percentage}%",
        "format-icons": {
            "default": "\uf293",
            "on": "\uf293",
            "off": "\uf294",
            "connected": "\uf293",
            "no-controller": "\uf294",
            "disabled": "\uf294"
        },
        "max-length": 30,
        "tooltip": true,
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-off": "Bluetooth is off\nRight-click to power on",
        "tooltip-format-on": "Bluetooth is on\nLeft-click to manage devices",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-no-controller": "No Bluetooth adapter found",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "on-click": "kaadzos-bluetooth manager",
        "on-click-right": "kaadzos-bluetooth toggle"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026 muted",
        "format-icons": ["\uf026", "\uf027", "\uf028"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol || foot -T Volume -e wpctl status"
    },
    "battery": {
        "states": { "good": 80, "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo} remaining"
    },
    "tray": { "icon-size": 18, "spacing": 8 }
}

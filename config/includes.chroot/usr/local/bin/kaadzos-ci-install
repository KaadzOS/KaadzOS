#!/bin/sh
# Unattended Calamares driver for ci/test-install.sh.
#
# This is only started from the Sway autostart when the VM exposes the CI DMI
# product name and the CI Calamares configuration is present. It advances the
# pages with synthetic Sway clicks and types field values with wtype
# (Wayland-native, so it works under Sway without a seat daemon), and writes
# progress markers to the serial console. product_name is used because
# /sys/class/dmi/id/product_serial is root-only; the live user could not read
# it.
set -u

serial=/dev/ttyS0
if [ ! -w "$serial" ]; then
  serial=/dev/null
fi

mark() {
  printf '%s\n' "$*" > "$serial" 2>/dev/null || true
}

# Never run on a normal live boot, in the installed system, or twice.
if [ ! -r /sys/class/dmi/id/product_name ]; then
  exit 0
fi
if [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" != "KAADZOS-CI-INSTALL" ]; then
  exit 0
fi
if [ ! -d /etc/calamares-ci ] || [ -e /etc/kaadzos/installed ]; then
  exit 0
fi
if [ -e /tmp/kaadzos-ci-install.started ]; then
  exit 0
fi
# /tmp is world-writable; /run is not, and a failed redirect is fatal under
# dash, which killed the driver before it could emit any marker.
: > /tmp/kaadzos-ci-install.started || true

mark "KAADZOS_INSTALLER_START"
mark "KAADZOS_TOOLS rsync=$(command -v rsync 2>/dev/null || echo missing) unsquashfs=$(command -v unsquashfs 2>/dev/null || echo missing) zstd=$(command -v zstd 2>/dev/null || echo missing)"

# Give the live session a moment to settle, then get the welcome terminal out
# of the way so Calamares owns the output.
sleep 10
pkill -x foot 2>/dev/null || true

log=/tmp/calamares-ci.log
: > "$log"
preload=
if [ -r /usr/local/lib/kaadzos-calamares-map.so ]; then
  preload=/usr/local/lib/kaadzos-calamares-map.so
fi
# Force the installer UI to US English: the driver navigates by position and
# types fixed values, so the CI run must not inherit an arbitrary live-session
# locale. Calamares reads QLocale::system(), which follows LANG.
if [ -n "$preload" ]; then
  sudo -E env HOME=/root LANG=en_US.UTF-8 QT_QPA_PLATFORM=wayland \
    LD_PRELOAD="$preload" \
    /usr/bin/calamares -c /etc/calamares-ci >>"$log" 2>&1 &
else
  sudo -E env HOME=/root LANG=en_US.UTF-8 QT_QPA_PLATFORM=wayland \
    /usr/bin/calamares -c /etc/calamares-ci >>"$log" 2>&1 &
fi
cal_pid=$!

wait_for_window() {
  i=0
  while [ "$i" -lt 180 ]; do
    if ! kill -0 "$cal_pid" 2>/dev/null; then
      return 1
    fi
    if window_matches; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

# Calamares does not necessarily expose the bare binary name as its Wayland
# app_id: Qt derives it from the desktop file name, so it can arrive as a
# reverse-DNS value such as io.calamares.calamares, and under XWayland the
# window only carries class/instance. Matching the value as a substring keeps
# the wait working for all three cases. The welcome page title is a last
# resort, since its text is known and stable for this build.
window_matches() {
  swaymsg -t get_tree 2>/dev/null \
    | grep -Eiq '"(app_id|class|instance)": "[^"]*calamares[^"]*"' && return 0
  swaymsg -t get_tree 2>/dev/null | grep -Fqi 'Welcome to the KaadzOS' && return 0
  return 1
}

# Bounded dump of every window key, so a future timeout records the real
# app_id instead of failing silently the way this one did.
dump_tree() {
  mark "KAADZOS_INSTALLER_TREE_BEGIN"
  swaymsg -t get_tree 2>/dev/null \
    | grep -E '"(app_id|name|class|instance)":' \
    | sed -n '1,80p' > "$serial" 2>&1 || true
  mark "KAADZOS_INSTALLER_TREE_END"
}

if ! wait_for_window; then
  mark "KAADZOS_INSTALLER_WINDOW_TIMEOUT"
  dump_tree
  wait "$cal_pid" 2>/dev/null
  mark "KAADZOS_INSTALL_EXIT rc=$?"
  mark "KAADZOS_CI_LOG_BEGIN"
  tail -n 400 "$log" > "$serial" 2>&1 || true
  mark "KAADZOS_CI_LOG_END"
  sudo -n poweroff -f 2>/dev/null || true
  exit 1
fi

mark "KAADZOS_INSTALLER_WINDOW"
# Sway criteria are regular expressions, so "calamares" already matches a
# reverse-DNS app_id. The class rule covers the XWayland case.
swaymsg '[app_id="calamares"] fullscreen enable' >/dev/null 2>&1 || true
swaymsg '[app_id="calamares"] focus' >/dev/null 2>&1 || true
swaymsg '[class="calamares"] fullscreen enable' >/dev/null 2>&1 || true
swaymsg '[class="calamares"] focus' >/dev/null 2>&1 || true
sleep 6

# Navigation. Do not use Calamares' Alt+N mnemonic: several pages focus a
# combo box (the Welcome page focuses the language selector), and that widget
# consumes "n" as type-ahead instead of letting the mnemonic reach the Next
# button. That is timing-dependent under emulation, which is how a UEFI run
# once ended up on the Norwegian language with the page never advancing.
# Sway can dispatch a synthetic left click, so click the standard bottom-right
# Next/Install button instead. Its centre is 90 px from the right edge and
# 18 px from the bottom edge at the CI resolution (1280x800); derive the
# resolution from the output mode so the click survives a future mode change.
click_next() {
  width=1280
  height=800
  # -p keeps the human-readable output when stdout is a pipe; swaymsg defaults
  # to JSON for non-terminals.
  mode=$(swaymsg -p -t get_outputs 2>/dev/null \
    | sed -n 's/^[[:space:]]*Current mode: \([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1 \2/p' \
    | head -n 1)
  if [ -n "$mode" ]; then
    width=${mode%% *}
    height=${mode##* }
  fi
  x=$((width - 90))
  y=$((height - 18))
  mark "KAADZOS_CI_CLICK x=$x y=$y"
  swaymsg seat - cursor set "$x" "$y" >/dev/null 2>&1 || true
  sleep 1
  swaymsg seat - cursor press button1 >/dev/null 2>&1 || true
  swaymsg seat - cursor release button1 >/dev/null 2>&1 || true
  sleep 1
}

mark "KAADZOS_CI_STEP welcome"
click_next
sleep 4

# The Location page is the only place the locale map is visible. The test
# captures it after this marker; keep the page up long enough for that
# screenshot before advancing.
mark "KAADZOS_CI_STEP locale"
sleep 8
click_next
sleep 3

mark "KAADZOS_CI_STEP keyboard"
click_next
# Give the partition module time to finish its device scan before Next is
# enabled on that page.
sleep 40

mark "KAADZOS_CI_STEP partition"
click_next
sleep 4

# Users page: onActivate() focuses the full name field. Full name, login name
# and hostname are the three focusable fields before the password box; the
# presets already contain sane values, so leave them alone.
mark "KAADZOS_CI_STEP users"
wtype -k Tab
wtype -k Tab
wtype -k Tab
sleep 1
wtype 'kaadzos2026'
sleep 1
wtype -k Tab
wtype 'kaadzos2026'
sleep 2
click_next
sleep 4

mark "KAADZOS_CI_STEP summary"
# Hold the Summary page so the CI can capture it, then start the install.
sleep 8
click_next

# 40 minute watchdog. Under TCG a full unpackfs + initramfs run is slow.
deadline=$(( $(date +%s) + 2400 ))
watchdog=0
while kill -0 "$cal_pid" 2>/dev/null; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    watchdog=1
    mark "KAADZOS_INSTALL_WATCHDOG"
    kill "$cal_pid" 2>/dev/null || true
    sleep 2
    kill -9 "$cal_pid" 2>/dev/null || true
    break
  fi
  sleep 5
done

wait "$cal_pid"
rc=$?

mark "KAADZOS_INSTALL_EXIT rc=$rc"
mark "KAADZOS_CI_LOG_BEGIN"
tail -n 400 "$log" > "$serial" 2>&1 || true
mark "KAADZOS_CI_LOG_END"

sync
sudo -n poweroff -f 2>/dev/null || true

if [ "$watchdog" -eq 1 ]; then
  exit 1
fi
exit "$rc"

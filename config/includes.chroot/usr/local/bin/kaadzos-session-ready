#!/bin/sh
# Emit CI readiness markers and desktop diagnostics to the serial console.
# The runner captures the serial log, so this needs no host-share mount.
set -eu

serial=/dev/ttyS0
if [ ! -w "$serial" ]; then
  serial=/dev/null
fi

mode=live
if [ -e /etc/kaadzos/installed ]; then
  mode=installed
fi
printf 'KAADZOS_MODE %s\n' "$mode" > "$serial"

printf 'KAADZOS_SWAY_WAIT\n' > "$serial"

attempt=0
ready=0
while [ "$attempt" -lt 60 ]; do
  if swaymsg -t get_outputs >/dev/null 2>&1; then
    printf 'KAADZOS_SWAY_READY\n' > "$serial"
    ready=1
    break
  fi

  attempt=$((attempt + 1))
  sleep 1
done

if [ "$ready" -ne 1 ]; then
  printf 'KAADZOS_SWAY_FAIL\n' > "$serial"
  exit 1
fi

# Confirm the themed configs landed in the live user's home.
for f in "$HOME/.config/sway/config" "$HOME/.config/waybar/style.css" \
         "$HOME/.config/foot/foot.ini"; do
  if [ -f "$f" ]; then
    printf 'KAADZOS_CFG %s bytes=%s\n' "$f" "$(wc -c < "$f")" > "$serial"
  else
    printf 'KAADZOS_CFG %s MISSING\n' "$f" > "$serial"
  fi
done

# Installed-system checks: live-only sudo and the Calamares package must be
# gone, and the first-boot cleanup must have completed.
if [ "$mode" = installed ]; then
  if [ -e /etc/sudoers.d/kaadzos-live ]; then
    printf 'KAADZOS_LIVE_SUDOERS_PRESENT\n' > "$serial"
  else
    printf 'KAADZOS_LIVE_SUDOERS_ABSENT\n' > "$serial"
  fi

  if command -v calamares >/dev/null 2>&1 || [ -d /etc/calamares ]; then
    printf 'KAADZOS_CALAMARES_PRESENT\n' > "$serial"
  else
    printf 'KAADZOS_CALAMARES_ABSENT\n' > "$serial"
  fi

  if [ -e /etc/kaadzos/firstboot-done ]; then
    printf 'KAADZOS_FIRSTBOOT_DONE\n' > "$serial"
  else
    printf 'KAADZOS_FIRSTBOOT_PENDING\n' > "$serial"
  fi
fi

# Under QEMU TCG the software renderer paints slowly; let the desktop draw.
sleep 8

# A swaynag error bar is spawned when the Sway config produces errors or
# warnings (e.g. an overwritten binding). That is a polish failure, so flag it
# explicitly for the boot test instead of shipping a desktop with a red banner.
if ps -eo args 2>/dev/null | grep -q '[s]waynag'; then
  printf 'KAADZOS_SWAY_CONFIG_WARNINGS\n' > "$serial"
fi

# Dump layout and logs between markers so the runner can parse them. The
# installed system intentionally lacks Calamares and the live logs, so do not
# let a missing path abort the block before the end marker is written.
set +e
{
  printf 'KAADZOS_DIAG_BEGIN\n'
  echo "=== mode ==="
  echo "$mode"
  echo '=== outputs ==='
  swaymsg -t get_outputs 2>&1
  echo '=== tree ==='
  swaymsg -t get_tree 2>&1
  echo '=== processes ==='
  ps -eo pid,args 2>/dev/null | grep -E '[w]aybar|[m]ako|[f]oot|[s]way|[g]reetd|[t]uigreet'
  echo '=== installer ==='
  if [ "$mode" = installed ]; then
    ls -l /etc/kaadzos 2>&1
    cat /etc/kaadzos/firstboot-done 2>&1
    ls -ld /etc/calamares /etc/calamares-ci /etc/live 2>&1
  fi
  for log in /tmp/sway.log /tmp/waybar.log /tmp/mako.log /tmp/calamares-ci.log; do
    echo "=== $log ==="
    cat "$log" 2>&1
  done
  echo '=== memory ==='
  free -m 2>/dev/null || true
  echo '=== swaps ==='
  cat /proc/swaps 2>/dev/null || true
  echo '=== zram ==='
  /usr/sbin/zramctl 2>&1 | head -n 6 || true
  echo '=== vm tuning ==='
  printf 'swappiness=%s page-cluster=%s\n' \
    "$(cat /proc/sys/vm/swappiness 2>/dev/null || echo '?')" \
    "$(cat /proc/sys/vm/page-cluster 2>/dev/null || echo '?')"
  echo '=== boot timing ==='
  systemd-analyze 2>/dev/null || true
  used=$(free -m 2>/dev/null | awk '/^Mem:/ {print $3; exit}')
  total=$(free -m 2>/dev/null | awk '/^Mem:/ {print $2; exit}')
  zram_devices=$(grep -c 'zram' /proc/swaps 2>/dev/null || true)
  zram_size_kb=$(awk '/zram/ {print $3; exit}' /proc/swaps 2>/dev/null)
  printf 'KAADZOS_IDLE_RAM used=%s total=%s zram_devices=%s zram_size_kb=%s\n' \
    "${used:--}" "${total:--}" "${zram_devices:-0}" "${zram_size_kb:--}"
  printf 'KAADZOS_DIAG_END\n'
} > "$serial" 2>&1
set -e

exit 0

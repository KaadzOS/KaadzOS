#!/bin/sh
# Emit CI readiness markers and desktop diagnostics to the serial console.
# The runner captures the serial log, so this needs no host-share mount.
set -eu

serial=/dev/ttyS0
if [ ! -w "$serial" ]; then
  serial=/dev/null
fi

mode=live
if [ -e /etc/kaadzos/installed ]; then
  mode=installed
fi
printf 'KAADZOS_MODE %s\n' "$mode" > "$serial"

printf 'KAADZOS_SWAY_WAIT\n' > "$serial"

attempt=0
ready=0
while [ "$attempt" -lt 60 ]; do
  if swaymsg -t get_outputs >/dev/null 2>&1; then
    printf 'KAADZOS_SWAY_READY\n' > "$serial"
    ready=1
    break
  fi

  attempt=$((attempt + 1))
  sleep 1
done

if [ "$ready" -ne 1 ]; then
  printf 'KAADZOS_SWAY_FAIL\n' > "$serial"
  exit 1
fi

# Confirm the themed configs landed in the live user's home.
for f in "$HOME/.config/sway/config" "$HOME/.config/waybar/style.css" \
         "$HOME/.config/foot/foot.ini"; do
  if [ -f "$f" ]; then
    printf 'KAADZOS_CFG %s bytes=%s\n' "$f" "$(wc -c < "$f")" > "$serial"
  else
    printf 'KAADZOS_CFG %s MISSING\n' "$f" > "$serial"
  fi
done

# Installed-system checks: live-only sudo and the Calamares package must be
# gone, and the first-boot cleanup must have completed.
if [ "$mode" = installed ]; then
  if [ -e /etc/sudoers.d/kaadzos-live ]; then
    printf 'KAADZOS_LIVE_SUDOERS_PRESENT\n' > "$serial"
  else
    printf 'KAADZOS_LIVE_SUDOERS_ABSENT\n' > "$serial"
  fi

  if command -v calamares >/dev/null 2>&1 || [ -d /etc/calamares ]; then
    printf 'KAADZOS_CALAMARES_PRESENT\n' > "$serial"
  else
    printf 'KAADZOS_CALAMARES_ABSENT\n' > "$serial"
  fi

  # The installed greeter must keep the AMOLED theme, the KaadzOS greeting and
  # the fixed VT written by kaadzos-install-finalize.
  if [ -r /etc/greetd/config.toml ] \
     && grep -q -- '--theme' /etc/greetd/config.toml \
     && grep -q -- '--greeting' /etc/greetd/config.toml \
     && grep -q 'vt = 7' /etc/greetd/config.toml; then
    printf 'KAADZOS_GREETER_OK\n' > "$serial"
  else
    printf 'KAADZOS_GREETER_MISSING\n' > "$serial"
  fi

  if [ -e /etc/kaadzos/firstboot-done ]; then
    printf 'KAADZOS_FIRSTBOOT_DONE\n' > "$serial"
  else
    printf 'KAADZOS_FIRSTBOOT_PENDING\n' > "$serial"
  fi
fi

# Under QEMU TCG the software renderer paints slowly; let the desktop draw.
sleep 8

# A swaynag error bar is spawned when the Sway config produces errors or
# warnings (e.g. an overwritten binding). That is a polish failure, so flag it
# explicitly for the boot test instead of shipping a desktop with a red banner.
if pgrep -x swaynag >/dev/null 2>&1; then
  printf 'KAADZOS_SWAY_CONFIG_WARNINGS\n' > "$serial"
fi

# Verify the core command-line baseline is present on both live and installed
# images. The boot test fails if any expected command is missing. A desktop
# user's PATH does not include sbin, but disk tools live there, so widen the
# lookup path rather than reporting them missing.
check_path="$PATH:/usr/sbin:/sbin"
missing_cmds=""
for cmd in bash dash zsh mount fdisk fsck find grep awk tar gzip xz zstd mkfs.ext4; do
  if ! PATH="$check_path" command -v "$cmd" >/dev/null 2>&1; then
    missing_cmds="$missing_cmds $cmd"
  fi
done
if [ -z "$missing_cmds" ]; then
  printf 'KAADZOS_COMMANDS_OK\n' > "$serial"
else
  printf 'KAADZOS_COMMANDS_MISSING%s\n' "$missing_cmds" > "$serial"
fi

# Bluetooth must be enabled in both the live and installed images, and it must
# not have failed. With no adapter systemd skips bluetooth.service because of
# its ConditionPathIsDirectory=/sys/class/bluetooth, which is healthy:
# is-failed is false for a skipped unit. A disabled unit is a packaging failure.
if systemctl is-failed --quiet bluetooth.service 2>/dev/null; then
  printf 'KAADZOS_BLUETOOTH_FAILED\n' > "$serial"
elif systemctl is-enabled --quiet bluetooth.service 2>/dev/null; then
  printf 'KAADZOS_BLUETOOTH_OK\n' > "$serial"
else
  printf 'KAADZOS_BLUETOOTH_DISABLED\n' > "$serial"
fi

# The bar must actually be running, and its generated config must carry the
# Bluetooth module wired to the helper. This catches a malformed waybar JSON
# that would otherwise leave the desktop without a bar.
if pgrep -x waybar >/dev/null 2>&1; then
  printf 'KAADZOS_WAYBAR_OK\n' > "$serial"
else
  printf 'KAADZOS_WAYBAR_FAILED\n' > "$serial"
fi
if grep -q '"bluetooth"' "$HOME/.config/waybar/config" 2>/dev/null \
   && grep -q 'kaadzos-bluetooth' "$HOME/.config/waybar/config" 2>/dev/null; then
  printf 'KAADZOS_BLUETOOTH_MODULE_OK\n' > "$serial"
else
  printf 'KAADZOS_BLUETOOTH_MODULE_MISSING\n' > "$serial"
fi

# The control centre is a helper plus a desktop entry plus a Waybar module.
# All three must be present so a clickable gear reaches a working menu.
if [ -x /usr/local/bin/kaadzos-control ] \
   && [ -f /usr/share/applications/kaadzos-control.desktop ] \
   && grep -q '"custom/control"' "$HOME/.config/waybar/config" 2>/dev/null; then
  printf 'KAADZOS_CONTROL_OK\n' > "$serial"
else
  printf 'KAADZOS_CONTROL_MISSING\n' > "$serial"
fi

# Settings needs the helper, the desktop entry and the config.d include that
# receives wallpaper, keyboard and touchpad overrides.
if [ -x /usr/local/bin/kaadzos-settings ] \
   && [ -f /usr/share/applications/kaadzos-settings.desktop ] \
   && grep -Fq 'include ~/.config/sway/config.d/*.conf' \
      "${HOME:-/root}/.config/sway/config" 2>/dev/null; then
  printf 'KAADZOS_SETTINGS_OK\n' > "$serial"
else
  printf 'KAADZOS_SETTINGS_MISSING\n' > "$serial"
fi

# Thunar context actions need the helper, the skel uca.xml, the archive
# plugin and the clipboard tool. gvfs-backends (admin://) is optional because
# it ships in the admin pack; the other pieces are in the base image.
plugin_so=$(find /usr/lib -type f -path '*/thunarx-3/thunar-archive-plugin.so' -print -quit 2>/dev/null || true)
if [ -x /usr/local/bin/kaadzos-file-action ] \
   && [ -f "${HOME:-/root}/.config/Thunar/uca.xml" ] \
   && grep -Fq 'kaadzos-file-action' "${HOME:-/root}/.config/Thunar/uca.xml" 2>/dev/null \
   && command -v wl-copy >/dev/null 2>&1 \
   && command -v xarchiver >/dev/null 2>&1 \
   && [ -n "$plugin_so" ]; then
  printf 'KAADZOS_FILE_ACTIONS_OK\n' > "$serial"
else
  printf 'KAADZOS_FILE_ACTIONS_MISSING\n' > "$serial"
fi

# lxpolkit is the session's polkit agent. Without it, admin://, package
# installation through pkexec and other privileged desktop actions cannot ask
# for authorization. Sway starts it with an exec line; give it a moment to
# appear before recording a failure.
polkit_attempt=0
while [ "$polkit_attempt" -lt 5 ] && ! pgrep -x lxpolkit >/dev/null 2>&1; do
  polkit_attempt=$((polkit_attempt + 1))
  sleep 1
done
if pgrep -x lxpolkit >/dev/null 2>&1; then
  printf 'KAADZOS_POLKIT_AGENT_OK\n' > "$serial"
else
  printf 'KAADZOS_POLKIT_AGENT_MISSING\n' > "$serial"
fi

# The portal service is D-Bus activated. Ping the well-known name so the check
# proves both the service files and the activation environment (Wayland plus
# the desktop name), not just that the packages are installed. Bound it so a
# broken portal cannot hold the serial diagnostics open.
if command -v gdbus >/dev/null 2>&1 \
   && timeout 20 gdbus call --session \
      --dest org.freedesktop.portal.Desktop \
      --object-path /org/freedesktop/portal/desktop \
      --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; then
  printf 'KAADZOS_PORTAL_OK\n' > "$serial"
else
  printf 'KAADZOS_PORTAL_FAILED\n' > "$serial"
fi

launcher_home=${HOME:-/root}
launcher_missing=''
for launcher_bin in kaadzos kaadzos-control kaadzos-file-action \
                    kaadzos-opencode kaadzos-packages kaadzos-search \
                    kaadzos-settings kaadzos-sway-session; do
  command -v "$launcher_bin" >/dev/null 2>&1 \
    || launcher_missing="$launcher_missing $launcher_bin"
done
for launcher_desktop in kaadzos-control kaadzos-packages kaadzos-settings; do
  [ -f "/usr/share/applications/$launcher_desktop.desktop" ] \
    || launcher_missing="$launcher_missing $launcher_desktop.desktop"
done
launcher_sway="$launcher_home/.config/sway/config"
for launcher_bind in \
  "bindsym \$mod+d exec kaadzos-search" \
  "bindsym \$mod+a exec kaadzos addons" \
  "bindsym \$mod+x exec kaadzos-bluetooth manager" \
  "bindsym \$mod+Shift+s exec kaadzos-control" \
  "bindsym \$mod+comma exec kaadzos-settings" \
  "bindsym \$mod+Shift+p exec kaadzos-packages" \
  "bindsym \$mod+Print exec kaadzos-record"; do
  grep -Fqx "$launcher_bind" "$launcher_sway" 2>/dev/null \
    || launcher_missing="$launcher_missing sway:$launcher_bind"
done
launcher_mime="$launcher_home/.config/mimeapps.list"
for launcher_default in \
  'inode/directory=thunar.desktop' \
  'text/plain=mousepad.desktop' \
  'application/pdf=zathura.desktop' \
  'image/png=imv-dir.desktop' \
  'x-scheme-handler/http=org.gnome.Epiphany.desktop'; do
  grep -Fqx "$launcher_default" "$launcher_mime" 2>/dev/null \
    || launcher_missing="$launcher_missing mime:$launcher_default"
done
if [ -z "$launcher_missing" ]; then
  printf 'KAADZOS_LAUNCHER_OK\n' > "$serial"
else
  printf 'KAADZOS_LAUNCHER_MISSING%s\n' "$launcher_missing" > "$serial"
fi

# Dump layout and logs between markers so the runner can parse them. The
# installed system intentionally lacks Calamares and the live logs, so do not
# let a missing path abort the block before the end marker is written.
set +e
{
  printf 'KAADZOS_DIAG_BEGIN\n'
  echo "=== mode ==="
  echo "$mode"
  echo '=== outputs ==='
  swaymsg -t get_outputs 2>&1
  echo '=== tree ==='
  swaymsg -t get_tree 2>&1
  echo '=== processes ==='
  pgrep -a -f '[w]aybar|[m]ako|[f]oot|[s]way|[g]reetd|[t]uigreet' 2>&1 || true
  echo '=== bluetooth ==='
  systemctl is-enabled bluetooth.service 2>&1
  systemctl is-failed bluetooth.service 2>&1
  timeout 5 systemctl status bluetooth.service --no-pager 2>&1 | head -n 12 || true
  # bluetoothctl waits for bluetoothd when the service is skipped for lack of
  # an adapter; never let the diagnostic block hang on it.
  timeout 5 bluetoothctl list 2>&1 || true
  echo '=== portals ==='
  timeout 10 gdbus call --session \
    --dest org.freedesktop.portal.Desktop \
    --object-path /org/freedesktop/portal/desktop \
    --method org.freedesktop.DBus.Peer.Ping 2>&1 || true
  timeout 5 busctl --user --list 2>/dev/null | grep -i portal || true
  if [ "$mode" = installed ]; then
    echo '=== greeter ==='
    cat /etc/greetd/config.toml 2>&1
  fi
  echo '=== settings ==='
  ls -l /usr/local/bin/kaadzos-settings \
    /usr/share/applications/kaadzos-settings.desktop 2>&1
  grep -F 'include ~/.config/sway/config.d/*.conf' \
    "$HOME/.config/sway/config" 2>&1 || true
  ls -l "$HOME/.config/sway/config.d" 2>&1
  echo '=== launchers ==='
  command -v kaadzos kaadzos-control kaadzos-file-action kaadzos-opencode \
    kaadzos-packages kaadzos-search kaadzos-settings kaadzos-sway-session 2>&1
  ls -l /usr/share/applications/kaadzos-control.desktop \
    /usr/share/applications/kaadzos-packages.desktop \
    /usr/share/applications/kaadzos-settings.desktop 2>&1
  grep -F "bindsym \$mod" "$launcher_sway" 2>&1 || true
  cat "$launcher_mime" 2>&1 || true
  echo '=== file actions ==='
  ls -l /usr/local/bin/kaadzos-file-action \
    "$HOME/.config/Thunar/uca.xml" \
    /usr/lib/*/thunarx-3/thunar-archive-plugin.so 2>&1
  command -v wl-copy xarchiver lxpolkit 2>&1 || true
  timeout 5 pgrep -a lxpolkit 2>&1 || true
  echo '=== installer ==='
  if [ "$mode" = installed ]; then
    ls -l /etc/kaadzos 2>&1
    cat /etc/kaadzos/firstboot-done 2>&1
    ls -ld /etc/calamares /etc/calamares-ci /etc/live 2>&1
  fi
  for log in /tmp/sway.log /tmp/waybar.log /tmp/mako.log /tmp/calamares-ci.log; do
    echo "=== $log ==="
    cat "$log" 2>&1
  done
  echo '=== memory ==='
  free -m 2>/dev/null || true
  echo '=== swaps ==='
  cat /proc/swaps 2>/dev/null || true
  echo '=== zram ==='
  /usr/sbin/zramctl 2>&1 | head -n 6 || true
  echo '=== vm tuning ==='
  printf 'swappiness=%s page-cluster=%s\n' \
    "$(cat /proc/sys/vm/swappiness 2>/dev/null || echo '?')" \
    "$(cat /proc/sys/vm/page-cluster 2>/dev/null || echo '?')"
  echo '=== boot timing ==='
  systemd-analyze 2>/dev/null || true
  used=$(free -m 2>/dev/null | awk '/^Mem:/ {print $3; exit}')
  total=$(free -m 2>/dev/null | awk '/^Mem:/ {print $2; exit}')
  zram_devices=$(grep -c 'zram' /proc/swaps 2>/dev/null || true)
  zram_size_kb=$(awk '/zram/ {print $3; exit}' /proc/swaps 2>/dev/null)
  printf 'KAADZOS_IDLE_RAM used=%s total=%s zram_devices=%s zram_size_kb=%s\n' \
    "${used:--}" "${total:--}" "${zram_devices:-0}" "${zram_size_kb:--}"
  printf 'KAADZOS_DIAG_END\n'
} > "$serial" 2>&1
set -e

exit 0

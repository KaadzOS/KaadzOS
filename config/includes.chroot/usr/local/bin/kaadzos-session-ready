#!/bin/sh
set -eu

serial=/dev/ttyS0
if [ ! -w "$serial" ]; then
  serial=/dev/null
fi

printf 'KAADZOS_SWAY_WAIT\n' > "$serial"

attempt=0
ready=0
while [ "$attempt" -lt 60 ]; do
  if swaymsg -t get_outputs >/dev/null 2>&1; then
    printf 'KAADZOS_SWAY_READY\n' > "$serial"
    ready=1
    break
  fi

  attempt=$((attempt + 1))
  sleep 1
done

if [ "$ready" -ne 1 ]; then
  printf 'KAADZOS_SWAY_FAIL\n' > "$serial"
  exit 1
fi

# Diagnostic: confirm the themed configs landed in the live user's home.
for f in "$HOME/.config/sway/config" "$HOME/.config/waybar/style.css" \
         "$HOME/.config/foot/foot.ini"; do
  if [ -f "$f" ]; then
    printf 'KAADZOS_CFG %s bytes=%s\n' "$f" "$(wc -c < "$f")" > "$serial"
  else
    printf 'KAADZOS_CFG %s MISSING\n' "$f" > "$serial"
  fi
done

# Under QEMU TCG the software renderer paints slowly; give the desktop a
# moment to draw the wallpaper, bar and terminal before capturing.
sleep 8

# Dump window/layer layout and process list for debugging the desktop look.
for dir in /run/hostshare /mnt/hostshare; do
  if [ -d "$dir" ] && [ -w "$dir" ]; then
    {
      echo '=== sway tree ==='
      swaymsg -t get_tree 2>&1
      echo '=== outputs ==='
      swaymsg -t get_outputs 2>&1
      echo '=== waybar procs ==='
      ps -eo pid,args 2>/dev/null | grep -E '[w]aybar|[m]ako|[f]oot|[s]way'
    } > "$dir/diag.txt" 2>&1
    break
  fi
done

# Capture the real Wayland output with grim for CI. QEMU's screendump cannot
# read a DRM/KMS scanout, so we write the PNG into the host-shared 9p folder
# (mounted read-write by run-hostshare.mount) where the runner picks it up.
for dir in /run/hostshare /mnt/hostshare; do
  if [ -d "$dir" ] && [ -w "$dir" ]; then
    grim "$dir/kaadzos-desktop.png" 2>/dev/null || true
    break
  fi
done

exit 0

#!/bin/sh
# KaadzOS settings. A small zenity front end over the session tools that are
# already present: swaymsg, gsettings, xdg-settings, nmcli, pavucontrol and
# the kaadzos helpers. Every optional tool is probed so a missing editor or
# daemon disables one row instead of breaking the whole application.
set -eu

have() {
  command -v "$1" >/dev/null 2>&1
}

notify() {
  if have notify-send; then
    notify-send -a KaadzOS "$@" >/dev/null 2>&1 || true
  fi
}

error() {
  notify -u critical "$1" "$2"
  printf 'kaadzos-settings: %s\n' "$2" >&2
  return 1
}

require_zenity() {
  if ! have zenity; then
    error "Settings" "zenity is not installed."
    exit 1
  fi
}

config_home=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}
state_dir=$config_home/kaadzos
state_file=$state_dir/settings.conf
sway_dir=$config_home/sway/config.d
file_action=${KAADZOS_FILE_ACTION:-kaadzos-file-action}

read_setting() {
  rs_key=$1
  rs_default=$2
  if [ -r "$state_file" ]; then
    rs_value=$(sed -n "s/^$rs_key=//p" "$state_file" | tail -n 1)
    if [ -n "$rs_value" ]; then
      printf '%s\n' "$rs_value"
      return 0
    fi
  fi
  printf '%s\n' "$rs_default"
}

write_setting() {
  ws_key=$1
  ws_value=$2
  mkdir -p "$state_dir" || error "Settings" "Could not create $state_dir"
  ws_tmp=$state_file.tmp.$$
  trap 'rm -f "$ws_tmp"' 0 1 2 15
  if [ -r "$state_file" ]; then
    grep -v "^$ws_key=" "$state_file" > "$ws_tmp" || true
  else
    : > "$ws_tmp"
  fi
  printf '%s=%s\n' "$ws_key" "$ws_value" >> "$ws_tmp"
  mv -f "$ws_tmp" "$state_file" || error "Settings" "Could not update $state_file"
  trap - 0 1 2 15
}

write_override() {
  wo_file=$1
  shift
  mkdir -p "$sway_dir" || error "Settings" "Could not create $sway_dir"
  wo_tmp=$wo_file.tmp.$$
  trap 'rm -f "$wo_tmp"' 0 1 2 15
  : > "$wo_tmp"
  for wo_line in "$@"; do
    printf '%s\n' "$wo_line" >> "$wo_tmp"
  done
  mv -f "$wo_tmp" "$wo_file" || error "Settings" "Could not update $wo_file"
  trap - 0 1 2 15
}

wallpaper() {
  path=${1:-}
  if [ -z "$path" ]; then
    require_zenity
    path=$(zenity --file-selection --title="Choose a wallpaper" \
      --file-filter="Images | *.png *.jpg *.jpeg *.webp *.svg") || exit 0
  fi
  [ -n "$path" ] || exit 0
  if ! "$file_action" wallpaper "$path"; then
    error "Wallpaper" "Could not apply $path."
    return 1
  fi
  write_setting wallpaper "$path"
  notify "Wallpaper" "Now using ${path##*/}."
}

keyboard() {
  layout=${1:-}
  if [ -z "$layout" ]; then
    require_zenity
    current=$(read_setting keyboard_layout us)
    layout=$(zenity --entry --title="Keyboard layout" \
      --text="XKB layout (for example us, de or us,ru):" \
      --entry-text="$current") || exit 0
  fi
  [ -n "$layout" ] || exit 0
  case $layout in
    *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_,+-]*)
      error "Keyboard" "Invalid layout: $layout"
      return 1
      ;;
  esac
  write_override "$sway_dir/20-keyboard.conf" \
    "# Generated by kaadzos-settings; edit the Keyboard setting instead." \
    "input type:keyboard {" \
    "    xkb_layout \"$layout\"" \
    "}"
  write_setting keyboard_layout "$layout"
  if have swaymsg; then
    if ! swaymsg input type:keyboard xkb_layout "$layout" >/dev/null 2>&1; then
      error "Keyboard" "Saved, but this session did not apply $layout."
      return 1
    fi
  fi
  notify "Keyboard" "Layout set to $layout."
}

touchpad() {
  state=${1:-}
  if [ -z "$state" ]; then
    require_zenity
    choice=$(zenity --list --title="Touchpad" --hide-header \
      --print-column=1 --column="Action" --column="Detail" \
      --width=520 --height=260 \
      "Touchpad: enable tap" "Tap the pad to click" \
      "Touchpad: disable tap" "Require a physical press") || exit 0
    case $choice in
      'Touchpad: enable tap') state=on ;;
      'Touchpad: disable tap') state=off ;;
      *) exit 0 ;;
    esac
  fi
  case $state in
    on) value=enabled ;;
    off) value=disabled ;;
    *)
      error "Touchpad" "Expected on or off, got: $state"
      return 1
      ;;
  esac
  write_override "$sway_dir/20-touchpad.conf" \
    "# Generated by kaadzos-settings; edit the Touchpad setting instead." \
    "input type:touchpad {" \
    "    tap $value" \
    "}"
  write_setting touchpad_tap "$state"
  if have swaymsg; then
    if ! swaymsg input type:touchpad tap "$value" >/dev/null 2>&1; then
      error "Touchpad" "Saved, but this session did not apply tap $value."
      return 1
    fi
  fi
  notify "Touchpad" "Tap to click is $value."
}

dark_style() {
  if ! have gsettings; then
    error "Appearance" "gsettings is not installed."
    return 1
  fi
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark \
    && gsettings set org.gnome.desktop.interface gtk-theme Adwaita \
    || { error "Appearance" "Could not enable the dark style."; return 1; }
  notify "Appearance" "Dark style enabled."
}

light_style() {
  if ! have gsettings; then
    error "Appearance" "gsettings is not installed."
    return 1
  fi
  gsettings set org.gnome.desktop.interface color-scheme default \
    && gsettings set org.gnome.desktop.interface gtk-theme Adwaita \
    || { error "Appearance" "Could not enable the light style."; return 1; }
  notify "Appearance" "Light style enabled."
}

font() {
  if ! have gsettings; then
    error "Appearance" "gsettings is not installed."
    return 1
  fi
  require_zenity
  current=$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null \
    | sed "s/^'//; s/'$//")
  [ -n "$current" ] || current="Inter Tight 11"
  value=$(zenity --entry --title="Interface font" \
    --text="Font family and size:" --entry-text="$current") || exit 0
  [ -n "$value" ] || exit 0
  case $value in
    *[[:cntrl:]]*|*\'*|*\"*)
      error "Appearance" "Refusing a font value with quotes or control characters."
      return 1
      ;;
  esac
  gsettings set org.gnome.desktop.interface font-name "$value" \
    || { error "Appearance" "Could not set the interface font."; return 1; }
  notify "Appearance" "Interface font set to $value."
}

icons() {
  if ! have gsettings; then
    error "Appearance" "gsettings is not installed."
    return 1
  fi
  require_zenity
  current=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null \
    | sed "s/^'//; s/'$//")
  [ -n "$current" ] || current=Adwaita
  value=$(zenity --entry --title="Icon theme" \
    --text="Icon theme name:" --entry-text="$current") || exit 0
  [ -n "$value" ] || exit 0
  case $value in
    *[[:cntrl:]]*|*\'*|*\"*)
      error "Appearance" "Refusing an icon value with quotes or control characters."
      return 1
      ;;
  esac
  gsettings set org.gnome.desktop.interface icon-theme "$value" \
    || { error "Appearance" "Could not set the icon theme."; return 1; }
  notify "Appearance" "Icon theme set to $value."
}

night_light() {
  if have kaadzos-control; then
    exec kaadzos-control night-light
  fi
  error "Night light" "kaadzos-control is not installed."
}

appearance() {
  require_zenity
  choice=$(zenity --list --title="Appearance" --hide-header \
    --print-column=1 --column="Action" --column="Detail" \
    --width=560 --height=420 \
    "Appearance: wallpaper" "Choose a background image" \
    "Appearance: night light" "Toggle warm colours" \
    "Appearance: dark style" "Use the dark interface" \
    "Appearance: light style" "Use the default interface" \
    "Appearance: UI font" "Change the interface font" \
    "Appearance: icon theme" "Change the icon theme") || exit 0
  case $choice in
    'Appearance: wallpaper') wallpaper ;;
    'Appearance: night light') night_light ;;
    'Appearance: dark style') dark_style ;;
    'Appearance: light style') light_style ;;
    'Appearance: UI font') font ;;
    'Appearance: icon theme') icons ;;
    *) exit 0 ;;
  esac
}

input_menu() {
  require_zenity
  choice=$(zenity --list --title="Input" --hide-header \
    --print-column=1 --column="Action" --column="Detail" \
    --width=520 --height=260 \
    "Input: keyboard layout" "Set the XKB layout" \
    "Input: touchpad tap" "Enable or disable tap to click") || exit 0
  case $choice in
    'Input: keyboard layout') keyboard ;;
    'Input: touchpad tap') touchpad ;;
    *) exit 0 ;;
  esac
}

display() {
  if have nwg-displays; then
    exec nwg-displays
  fi
  if have wlr-randr; then
    tmp=${TMPDIR:-/tmp}/kaadzos-display.txt
    wlr-randr > "$tmp" 2>&1 || true
    if have zenity; then
      exec zenity --text-info --title="Display" --filename="$tmp" \
        --width=640 --height=360
    fi
    require_zenity
  fi
  error "Display" "Install nwg-displays or wlr-randr to change outputs."
  return 1
}

network() {
  if have nm-connection-editor; then
    exec nm-connection-editor
  fi
  if have nmcli; then
    tmp=${TMPDIR:-/tmp}/kaadzos-network.txt
    nmcli device status > "$tmp" 2>&1 || true
    if have zenity; then
      exec zenity --text-info --title="Network" --filename="$tmp" \
        --width=640 --height=320
    fi
  fi
  error "Network" "Install nm-connection-editor or nmcli to manage connections."
  return 1
}

bluetooth() {
  if have kaadzos-bluetooth; then
    exec kaadzos-bluetooth manager
  fi
  if have blueman-manager; then
    exec blueman-manager
  fi
  error "Bluetooth" "Install Blueman to manage devices."
  return 1
}

sound() {
  if have pavucontrol; then
    exec pavucontrol
  fi
  if have wpctl; then
    exec foot -T Audio -e wpctl status
  fi
  error "Sound" "Install pavucontrol to manage audio."
  return 1
}

power() {
  if have kaadzos-control; then
    exec kaadzos-control power
  fi
  error "Power" "kaadzos-control is not installed."
}

packages() {
  if have kaadzos-packages; then
    exec kaadzos-packages
  fi
  error "Packages" "kaadzos-packages is not installed."
}

browser() {
  if ! have xdg-settings; then
    error "Default browser" "xdg-settings is not installed."
    return 1
  fi
  xdg-settings set default-web-browser epiphany.desktop \
    || { error "Default browser" "Could not set GNOME Web."; return 1; }
  notify "Default browser" "GNOME Web is now the default browser."
}

file_manager() {
  if ! have xdg-mime; then
    error "Default file manager" "xdg-mime is not installed."
    return 1
  fi
  xdg-mime default thunar.desktop inode/directory \
    || { error "Default file manager" "Could not set Thunar."; return 1; }
  notify "Default file manager" "Thunar is now the default file manager."
}

about() {
  release=${KAADZOS_OS_RELEASE:-/etc/os-release}
  name=KaadzOS
  if [ -r "$release" ]; then
    name=$(sed -n 's/^PRETTY_NAME=//p' "$release" | head -n 1 | tr -d '"')
  fi
  [ -n "$name" ] || name=KaadzOS
  kernel=$(uname -r 2>/dev/null || printf 'unknown')
  text=$(printf '%s\nKernel: %s\nSession: %s' \
    "$name" "$kernel" "${XDG_CURRENT_DESKTOP:-unknown}")
  if have zenity; then
    exec zenity --info --no-markup --title="About KaadzOS" --text="$text"
  fi
  notify "About KaadzOS" "$text"
}

main_menu() {
  require_zenity
  choice=$(zenity --list --title="KaadzOS Settings" --hide-header \
    --print-column=1 --column="Section" --column="Detail" \
    --width=620 --height=540 \
    "Appearance" "Wallpaper, style, font and night light" \
    "Input" "Keyboard layout and touchpad" \
    "Display" "Arrange outputs" \
    "Network" "Wired, wireless and VPN connections" \
    "Bluetooth" "Devices and adapter power" \
    "Sound" "Volume mixer" \
    "Power" "Battery, profile and session" \
    "Packages" "Software and optional packs" \
    "Default browser" "Use GNOME Web" \
    "Default file manager" "Use Thunar" \
    "About" "Version and session") || exit 0
  case $choice in
    Appearance) appearance ;;
    Input) input_menu ;;
    Display) display ;;
    Network) network ;;
    Bluetooth) bluetooth ;;
    Sound) sound ;;
    Power) power ;;
    Packages) packages ;;
    'Default browser') browser ;;
    'Default file manager') file_manager ;;
    About) about ;;
    *) error "Settings" "Unknown section: $choice"; exit 2 ;;
  esac
}

case "${1:-menu}" in
  menu) main_menu ;;
  appearance) appearance ;;
  input) input_menu ;;
  display) display ;;
  network) network ;;
  bluetooth) bluetooth ;;
  sound) sound ;;
  power) power ;;
  packages) packages ;;
  browser) browser ;;
  file-manager) file_manager ;;
  about) about ;;
  wallpaper) wallpaper "${2:-}" ;;
  keyboard) keyboard "${2:-}" ;;
  touchpad) touchpad "${2:-}" ;;
  dark-style) dark_style ;;
  light-style) light_style ;;
  font) font ;;
  icons) icons ;;
  night-light) night_light ;;
  *)
    echo "usage: kaadzos-settings [menu|appearance|input|display|network|bluetooth|sound|power|packages|browser|file-manager|about|wallpaper [PATH]|keyboard [LAYOUT]|touchpad [on|off]|dark-style|light-style|font|icons|night-light]" >&2
    exit 2
    ;;
esac

#!/bin/sh
# Launch the KaadzOS installer. Calamares needs root, but the live session
# runs as the unprivileged kaadzos user, so re-exec through sudo with the
# Wayland environment preserved (live sudoers grants SETENV for this).
set -eu

if [ "$(id -u)" -eq 0 ]; then
  exec /usr/bin/calamares -c /etc/calamares "$@"
fi

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  platform=wayland
else
  platform=xcb
fi

# -c pins the app-data directory (settings, modules, branding and the required
# qml/ dir) instead of relying on the distro-compiled default.
exec sudo -E env HOME=/root QT_QPA_PLATFORM="$platform" \
  /usr/bin/calamares -c /etc/calamares "$@"

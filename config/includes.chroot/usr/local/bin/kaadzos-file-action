#!/bin/sh
# Safe file actions shared by the settings application and, later, Thunar.
# The path is always a positional argument: never eval it, never concatenate
# it into a shell string, and reject anything that cannot be written into a
# Sway config line without ambiguity.
set -eu

have() {
  command -v "$1" >/dev/null 2>&1
}

notify() {
  if have notify-send; then
    notify-send -a KaadzOS "$@" >/dev/null 2>&1 || true
  fi
}

fail() {
  printf 'kaadzos-file-action: %s\n' "$1" >&2
  notify "File action" "$1"
  exit 2
}

usage() {
  echo "usage: kaadzos-file-action wallpaper PATH" >&2
  exit 2
}

[ "$#" -eq 2 ] || usage
action=$1
path=$2

case $action in
  wallpaper) ;;
  *) usage ;;
esac

[ -n "$path" ] || fail "The path is empty."
case $path in
  -*) fail "Refusing a path that begins with '-'." ;;
esac
case $path in
  *[[:cntrl:]]*) fail "Refusing a path containing control characters." ;;
esac
[ -e "$path" ] || fail "No such file: $path"
[ -f "$path" ] || fail "Not a regular file: $path"
[ -r "$path" ] || fail "Not readable: $path"

config_home=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}
override_dir=$config_home/sway/config.d
override=$override_dir/10-wallpaper.conf
mkdir -p "$override_dir" || fail "Could not create $override_dir"

# Sway double-quoted strings take backslash escapes; control characters were
# rejected above, so only backslash and quote need escaping.
escaped=$(printf '%s' "$path" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
tmp=$override.tmp.$$
trap 'rm -f "$tmp"' 0 1 2 15
{
  printf '# Generated by kaadzos-file-action; change the wallpaper setting instead.\n'
  printf 'output * bg "%s" fill\n' "$escaped"
} > "$tmp" || fail "Could not write $tmp"
mv -f "$tmp" "$override" || fail "Could not replace $override"
trap - 0 1 2 15

if have swaymsg; then
  if ! swaymsg output '*' bg "$path" fill >/dev/null 2>&1; then
    notify -u critical "Wallpaper" "Saved, but this session did not apply it."
    exit 1
  fi
fi

name=${path##*/}
notify "Wallpaper" "Now using $name."

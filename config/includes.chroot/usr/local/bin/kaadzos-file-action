#!/bin/sh
# Safe file actions shared by the settings application and Thunar custom
# actions. A path is always a positional argument: never eval it, never
# concatenate it into a shell string, and reject names that cannot be passed
# unambiguously.
set -eu

have() {
  command -v "$1" >/dev/null 2>&1
}

notify() {
  if have notify-send; then
    notify-send -a KaadzOS "$@" >/dev/null 2>&1 || true
  fi
}

fail() {
  printf 'kaadzos-file-action: %s\n' "$1" >&2
  notify "File action" "$1"
  exit 2
}

usage() {
  cat >&2 <<'EOF'
usage: kaadzos-file-action ACTION [PATH]
  wallpaper PATH        set PATH as the Sway wallpaper
  copy-path PATH        copy PATH to the Wayland clipboard
  open-terminal PATH    open a terminal in PATH or its containing folder
  admin-open PATH       open PATH through Thunar's admin:// location
  install-package PATH  install a local .deb after confirmation
  open-settings         open kaadzos-settings
EOF
  exit 2
}

[ "$#" -ge 1 ] || usage
action=$1

case $action in
  open-settings)
    shift
    [ "$#" -eq 0 ] || usage
    have kaadzos-settings || fail "kaadzos-settings is not installed."
    exec kaadzos-settings
    ;;
  wallpaper|copy-path|open-terminal|admin-open|install-package)
    shift
    [ "$#" -eq 1 ] || usage
    path=$1
    ;;
  *)
    usage
    ;;
esac

[ -n "$path" ] || fail "The path is empty."
case $path in
  -*) fail "Refusing a path that begins with '-'." ;;
esac
case $path in
  *'$'*) fail "Refusing a path containing '$'." ;;
esac
case $path in
  *\`*) fail "Refusing a path containing a backtick." ;;
esac
case $path in
  *[[:cntrl:]]*) fail "Refusing a path containing control characters." ;;
esac
[ -e "$path" ] || fail "No such path: $path"

case $action in
  wallpaper)
    [ -f "$path" ] || fail "Not a regular file: $path"
    [ -r "$path" ] || fail "Not readable: $path"

    config_home=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}
    override_dir=$config_home/sway/config.d
    override=$override_dir/10-wallpaper.conf
    mkdir -p "$override_dir" || fail "Could not create $override_dir"

    # Sway double-quoted strings take backslash escapes; control characters
    # were rejected above, so only backslash and quote need escaping.
    escaped=$(printf '%s' "$path" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    tmp=$override.tmp.$$
    trap 'rm -f "$tmp"' 0 1 2 15
    {
      printf '# Generated by kaadzos-file-action; change the wallpaper setting instead.\n'
      printf 'output * bg "%s" fill\n' "$escaped"
    } > "$tmp" || fail "Could not write $tmp"
    mv -f "$tmp" "$override" || fail "Could not replace $override"
    trap - 0 1 2 15

    if have swaymsg; then
      # swaymsg joins its arguments with spaces, so pass the whole command as
      # one argument; the path stays inside the Sway double-quoted string.
      if ! swaymsg "output * bg \"$escaped\" fill" >/dev/null 2>&1; then
        notify -u critical "Wallpaper" "Saved, but this session did not apply it."
        exit 1
      fi
    fi

    name=${path##*/}
    notify "Wallpaper" "Now using $name."
    ;;

  copy-path)
    [ -r "$path" ] || fail "Not readable: $path"
    have wl-copy || fail "wl-clipboard is not installed."
    if ! printf '%s' "$path" | wl-copy; then
      fail "Could not copy the path to the clipboard."
    fi
    notify "Path copied" "$path"
    ;;

  open-terminal)
    if [ -d "$path" ]; then
      terminal_dir=$path
    elif [ -f "$path" ]; then
      terminal_dir=$(dirname "$path") || fail "Could not resolve the folder for: $path"
    else
      fail "Not a file or directory: $path"
    fi
    [ -x "$terminal_dir" ] || fail "The directory is not searchable: $terminal_dir"
    have foot || fail "foot is not installed."
    exec foot --working-directory="$terminal_dir"
    ;;

  admin-open)
    [ -d "$path" ] || fail "Not a directory: $path"
    case $path in
      /*) ;;
      *) fail "The path must be absolute." ;;
    esac
    # These characters are special in a URI; refuse them instead of trying to
    # build a percent-encoded URI in shell.
    case $path in
      *'#'*|*'?'*|*'%'*) fail "The path cannot be used in an admin:// URI." ;;
    esac
    have thunar || fail "Thunar is not installed."
    gvfsd_admin=${KAADZOS_GVFSD_ADMIN:-/usr/libexec/gvfsd-admin}
    [ -x "$gvfsd_admin" ] || fail "Administrator access needs the admin pack (gvfs-backends)."
    exec thunar "admin://$path"
    ;;

  install-package)
    [ -f "$path" ] || fail "Not a regular file: $path"
    [ -r "$path" ] || fail "Not readable: $path"
    case $path in
      *.deb) ;;
      *) fail "Not a .deb package: $path" ;;
    esac
    case $path in
      /*) ;;
      *) fail "The package path must be absolute." ;;
    esac
    have kaadzos-packages || fail "kaadzos-packages is not installed."
    exec kaadzos-packages install-deb "$path"
    ;;
esac

#!/bin/sh
set -eu

# Passwordless sudo for the live user so 'kaadzos add/remove/update' and the
# Calamares installer can run without a password prompt (the live account has
# no known password). SETENV lets the installer preserve the Wayland
# environment when it re-executes Calamares as root. This is live-only
# configuration and is removed by the installer.
if [ -d /etc/sudoers.d ]; then
  printf 'kaadzos ALL=(ALL) NOPASSWD: SETENV: ALL\n' > /etc/sudoers.d/kaadzos-live
  chmod 440 /etc/sudoers.d/kaadzos-live
  # Fail the build early if the snippet is somehow invalid.
  visudo -cf /etc/sudoers.d/kaadzos-live >/dev/null
fi

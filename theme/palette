#!/bin/sh
# KaadzOS "AMOLED" palette -- the single source of truth for the entire theme.
#
# Every themed config (Sway, Waybar, foot, fuzzel, mako, swaylock, GTK, Qt,
# wallpaper, console) is generated from these values by theme/generate.sh.
# Edit colours here, then re-run theme/generate.sh to propagate.
#
# Design: true #000 black, white text and a white accent, matching the
# website's editorial black-and-white design. Surfaces are neutral near-black
# rather than tinted, and the terminal ANSI slots are deliberately near-neutral
# so the desktop stays AMOLED-first. Red is reserved for errors/urgent state;
# the muted green/yellow slots are only for semantic terminal status.

# ---------------------------------------------------------------- raw colours
KAADZ_BLACK="#000000"
KAADZ_MANTLE="#050505"
KAADZ_SURFACE="#0a0a0a"
KAADZ_OVERLAY="#161616"
KAADZ_BORDER="#292929"
KAADZ_SUBT0="#8a8a8a"
KAADZ_SUBT1="#9c9c9c"
KAADZ_TEXT="#ffffff"
KAADZ_SKY="#e6e6e6"
KAADZ_BLUE="#ffffff"           # legacy ANSI slot; now the white accent
KAADZ_PURPLE="#d0d0d0"
KAADZ_TEAL="#b8b8b8"
KAADZ_GREEN="#c0c8c0"          # muted success, not a UI colour
KAADZ_YELLOW="#d6c08a"         # muted warning, not a UI colour
KAADZ_ORANGE="#c8a888"
KAADZ_RED="#ff5c5c"
KAADZ_PINK="#d0c0c0"

# ------------------------------------------------------------- semantic roles
# Surfaces / background
KAADZ_BG="$KAADZ_BLACK"        # true-black AMOLED background
KAADZ_BG_ALT="$KAADZ_MANTLE"   # almost-black bars and raised base
KAADZ_SURFACE="$KAADZ_SURFACE" # cards, popups, menus
KAADZ_BORDER="$KAADZ_BORDER"   # hairlines, separators, outlines

# Foreground / text
KAADZ_FG="$KAADZ_TEXT"         # primary text (highest contrast)
KAADZ_FG_ALT="$KAADZ_SUBT1"    # secondary text
KAADZ_FG_MUTED="$KAADZ_SUBT0"  # muted / disabled text

# Accents & states
KAADZ_ACCENT="$KAADZ_BLUE"     # white accent (focus, highlights)
KAADZ_ACCENT_ALT="$KAADZ_PURPLE"
KAADZ_URGENT="$KAADZ_RED"      # errors, close, urgent
KAADZ_WARNING="$KAADZ_YELLOW"
KAADZ_SUCCESS="$KAADZ_GREEN"
KAADZ_INFO="$KAADZ_TEAL"
KAADZ_URGENT_FG="$KAADZ_BLACK" # text drawn on an urgent background

# --------------------------------------------------------------- typography
KAADZ_FONT_UI="Inter"          # sans-serif UI font
KAADZ_FONT_MONO="JetBrains Mono" # monospace / terminal font
KAADZ_FONT_FALLBACK="DejaVu Sans"
KAADZ_FONT_SIZE="11"
KAADZ_FONT_SIZE_TERM="12"
